<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
                <StackPanel x:Name="PanCustom">
                </StackPanel>
                <local:MyCard Margin="0,0,0,15" Title="社区版提示" x:Name="PanHint"
                    HorizontalAlignment="Center" MaxWidth="760">
                <local:MyIconButton LogoScale="1.1" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                                    Height="20" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    x:Name="BtnHintClose" />
                <StackPanel Margin="25,38,23,15">
                    <TextBlock x:Name="LabHint1" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
                    <TextBlock x:Name="LabHint2" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog"
                HorizontalAlignment="Center" MaxWidth="760">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
            </local:MyCard>
        </StackPanel>
        </local:MyScrollViewer>

        <!-- 云端同步 — 卡片式布局 -->
        <Grid x:Name="PanCloud" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 已连接：顶部信息栏 -->
            <StackPanel x:Name="PanCloudHeader" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="云端同步 · " FontSize="13" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                <TextBlock x:Name="LabCloudDomain" FontSize="13" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                <local:MyButton x:Name="BtnCloudRefresh" Text="刷新" Height="24" Padding="8,0" Margin="12,0,0,0" ColorType="Highlight" />
                <local:MyButton x:Name="BtnCloudDisconnect" Text="断开" Height="24" Padding="8,0" Margin="8,0,0,0" ColorType="Normal" />
            </StackPanel>

            <!-- 卡片列表区域（已连接时显示） -->
            <local:MyScrollViewer x:Name="PanCloudCards" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <WrapPanel x:Name="CloudCardsPanel" Margin="15,0,0,0" HorizontalAlignment="Center" />
            </local:MyScrollViewer>

            <!-- 未连接：居中大卡片 -->
            <StackPanel x:Name="PanCloudDisconnected" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <local:MyCard Margin="0,0,0,10" CornerRadius="12" Opacity="10" x:Name="CardCloudAdd"
                    Cursor="Hand" ToolTip="连接到云端服务器，同步云端整合包">
                    <StackPanel Margin="40,30,40,30">
                        <TextBlock Text="＋" FontSize="36" Foreground="{DynamicResource ColorBrush4}"
                            HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold" />
                        <TextBlock Text="添加新的云同步" FontSize="15" Foreground="{DynamicResource ColorBrush2}"
                            HorizontalAlignment="Center" FontWeight="Medium" />
                        <TextBlock Text="连接到云端服务器，同步云端整合包" FontSize="11.5"
                            Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Center"
                            Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </Grid>
    </Grid>
</local:MyPageRight>
